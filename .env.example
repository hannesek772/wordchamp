PORT=3000
HOST=0.0.0.0
# Generate with: npm run password
TEACHER_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Public HTTPS origin used by students and QR codes; no trailing slash
PUBLIC_URL=http://localhost:3000
# Set behind an HTTPS reverse proxy in production
NODE_ENV=development
TRUST_PROXY=0
DB_PATH=var/wordchamp.sqlite
